# Copy to backend/.env and fill in. deploy.sh creates it from this file on first run.

# MongoDB connection (default: local mongod without auth)
MONGO_URI=mongodb://localhost:27017

# AI provider used for content generation: openai | gemini
AI_PROVIDER=openai

# Both keys are required: each AI service refuses to start without its key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
